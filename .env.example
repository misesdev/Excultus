# Copy to .env (ignored by git) to publish on Zapstore locally.
# zsp reads this file automatically. Guide: docs/zapstore.md

# Nostr key that signs the publications: nsec1..., bunker://... or "browser" (NIP-07)
SIGN_WITH=nsec1...

# Release keystore password, used by `zsp identity --link-key`
KEYSTORE_PASSWORD=
