# Copie para .env (ignorado pelo git) para publicar no Zapstore localmente.
# O zsp lê este arquivo automaticamente. Guia: docs/zapstore.md

# Chave Nostr que assina as publicações: nsec1..., bunker://... ou "browser" (NIP-07)
SIGN_WITH=nsec1...

# Senha do keystore de release, usada por `zsp identity --link-key`
KEYSTORE_PASSWORD=
