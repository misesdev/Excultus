{
  "name": "excultus",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "start": "react-native start",
    "test": "jest",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "test:coverage": "jest --coverage",
    "validate": "npm run typecheck && npm run lint && npm test",
    "android:release": "cd android && ./gradlew assembleRelease",
    "e2e": "maestro test e2e/flows",
    "prepare": "husky",
    "e2e:offline": "maestro test --include-tags=offline e2e/flows"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.40.4",
    "@hookform/resolvers": "^5.9.2",
    "@op-engineering/op-sqlite": "^18.2.5",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-documents/picker": "^12.0.3",
    "@react-native-vector-icons/ionicons": "^14.0.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "react": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-native": "0.88.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.30.0",
    "react-native-track-player": "^4.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^17.6.0",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "op-sqlite": {
    "fts5": true
  },
  "codegenConfig": {
    "name": "ExcultusSpecs",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.excultus.specs"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ]
  }
}
